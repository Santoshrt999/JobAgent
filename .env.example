# ===========================================================================
# job-agent environment variables (EXAMPLE)
# Copy this file to ".env" and fill in values. NEVER commit your real .env.
# Secrets are read only from process.env and are never written to logs.
# ===========================================================================

# --- AI providers ---
# The OPTIONAL LLM assist layer is configured at the bottom of this file
# (LLM_ASSIST / LLM_PROVIDER). With it off (the default), resume tailoring and
# cover letters are fully deterministic and never call a model.

# --- Apify (real multi-portal job discovery via apify.com actors) ---
# Create a token at https://console.apify.com/account/integrations
# NOTE: billed per run. The FREE plan's $5/month cap stops every actor once
# reached, and discovery falls back to the keyless sources below until it resets.
APIFY_TOKEN=

# --- Adzuna (official job aggregator API; OPTIONAL, free tier) ---
# Query-first discovery across aggregated listings — the closest keyed
# substitute for Apify's Indeed/LinkedIn breadth. Register free at
# https://developer.adzuna.com/ (~1,000 calls/month), then set
# `adzuna-aggregator` to enabled:true in config/jobboards.json.
# Leave blank to skip: the source reports one clear error and costs nothing.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# No key needed for `ats-search` (Workable + SmartRecruiters cross-company
# search). It is enabled by default and costs nothing.

# --- Job platform credentials: intentionally none ---
# There are no LinkedIn/Dice/Indeed/Glassdoor login variables. Nothing in this
# codebase logs in to a job board: every connector reads a public endpoint, and
# the sources that require evasion to query are disabled by design. Variables
# were listed here for years that no line of code read — an invitation to put
# four job-board passwords in plaintext for features that do not exist.

# --- Notifications ---
# There is no email/SMTP support (SMTP_* and NOTIFY_TO were once listed here and
# read by nothing). The dashboard is the main notification surface; `npm run
# watch` can also raise a desktop notification — see WATCH_NOTIFY below.

# --- Runtime controls ---
# RUN_MODE: DRY_RUN | PREPARE | LIVE_ASSIST
#   DRY_RUN     plan only, no browser actions
#   PREPARE     build tailored resume + application packet, stop
#   LIVE_ASSIST open the form and fill it, STOP before submit (you click Submit)
# LIVE_ASSIST fills forms and normally stops for human review. The dashboard
# also offers Auto-Apply, but only after an explicit one-run authorization and
# a fresh server-side eligibility check; CAPTCHA/MFA, unknown required fields,
# upload failures, daily-cap limits, or missing confirmation evidence stop it.
RUN_MODE=DRY_RUN
MAX_APPLICATIONS_PER_DAY=15
HEADLESS=false

# --- Browser profile (optional) ---
# Your login/cookies are REMEMBERED between runs by default: the agent uses a
# dedicated, project-local profile (job-agent/.browser-profile[-<channel>]/) — so
# you sign in to Indeed/ATS sites ONCE and never again. (Git-ignored; delete the
# folder to reset all saved logins.)
# Set BROWSER_CHANNEL to run your REAL installed browser instead of bundled
# Chromium: 'msedge' for Microsoft Edge, or 'chrome' for Google Chrome. It still
# uses the dedicated profile above, so it NEVER conflicts with your everyday
# browser windows.
#
# BROWSER_USER_DATA_DIR is advanced/discouraged: pointing it at your LIVE browser
# "User Data" folder usually fails, because Edge/Chrome keep background processes
# running and forward the launch to that instance (you get a dead about:blank
# tab). Leave it blank unless you have fully disabled background/boost and closed
# every window of that browser.
BROWSER_CHANNEL=
BROWSER_USER_DATA_DIR=
# Slow each Playwright action by N ms so you can watch the bot type/click/upload
# while running headed (0 = full speed). 100–200 is a comfortable pace.
BROWSER_SLOW_MO=0

# --- Multi-step form filling ---
# LIVE_ASSIST walks multi-step forms, clicking only safe forward controls
# (Next/Continue/Review) and filling every field it can from your profile/config.
# Without the dashboard's explicit one-run Auto-Apply authorization it NEVER
# clicks a final Submit/Apply/Finish. Every run stops on captcha/login/MFA/bot
# walls or any required question it cannot answer truthfully.
# Max number of pages LIVE_ASSIST will advance through before it stops.
ASSIST_MAX_STEPS=8
# Also export a PDF next to each tailored .docx resume (most ATS prefer PDF).
RESUME_EXPORT_PDF=true

# --- Freshness (prioritize recent postings) ---
# JOB_FRESHNESS_MODE: LAST_24_HOURS | LAST_3_DAYS | LAST_7_DAYS | LAST_14_DAYS | LAST_30_DAYS | ALL
# (The dashboard's More actions -> Discovery & data quality setting overrides this.)
#   The primary recency window applied to discovered jobs BEFORE scoring.
#   Default LAST_7_DAYS: real requisitions stay open for weeks; a 3-day hard
#   window was measured discarding >75% of scoreable jobs (including 75+
#   scoring senior roles) before ranking. Tighten only if volume overwhelms.
#   (Note: Indeed/Apify already pre-filter by datePosted; Greenhouse/Lever board
#   APIs expose no posting date, so those jobs are "undated" — see below.)
JOB_FRESHNESS_MODE=LAST_7_DAYS
# When a strict window (e.g. LAST_24_HOURS) keeps fewer than
# MIN_RESULTS_BEFORE_3_DAY_FALLBACK dated jobs, widen automatically to 3 days.
INCLUDE_LAST_3_DAYS_FALLBACK=true
MIN_RESULTS_BEFORE_3_DAY_FALLBACK=10
# Jobs whose posting date is unknown (most Greenhouse/Lever board jobs) are
# NEVER mixed into the fresh "last 24 hours / last 3 days" results. Off by
# default (false). When set to true, undated jobs are surfaced ONLY in a
# separate review bucket (data/unknown_date_review.json) for you to triage
# manually — they are never scored, prepared, or applied to automatically.
INCLUDE_UNKNOWN_DATE_JOBS=false
# Optional Chrome/Edge extension companion. Generate a unique value with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Paste the same value into the extension's Connection settings.
JOB_AGENT_EXTENSION_KEY=
# Exclude jobs you have already submitted (applied=1) from discovery so you are
# never shown or re-prepared for a job you already applied to.
EXCLUDE_ALREADY_APPLIED=true

# --- Watch mode (be first to apply) ---
# `npm run watch` polls continuously, tailors a packet for every NEW strong
# match, and alerts you instantly (console banner + terminal bell). It NEVER
# submits — you review and click apply. Watch always uses a last-24-hours window.
#   --free-only flag  : poll ONLY the zero-cost public boards (skip Apify).
#   --once flag       : run a single cycle and exit (handy for cron).
#   --interval=N      : minutes between cycles (min 5; overrides the env below).
# How often to poll (minutes). Lower = fresher, but Apify sources charge PER
# CYCLE, so a short interval with LinkedIn/Indeed enabled costs more. Free
# boards cost nothing regardless.
WATCH_INTERVAL_MINUTES=20
# Postings newer than this many minutes get an extra-loud "[BE EARLY]" alert.
WATCH_FRESH_ALERT_MINUTES=60
# A failed cycle is retried after 1, 2, 4… minutes (never longer than the poll
# interval); after this many failures IN A ROW watch gives up and exits 1.
# Also --max-failures=N.
WATCH_MAX_FAILURES=5
# 1 = also raise a desktop notification for new matches (macOS Notification
# Center / Linux notify-send; terminal bell elsewhere). Off by default.
WATCH_NOTIFY=0

# --- Dashboard / app launcher ---
# Port for `npm run app` / the launchers (default 4646). If a Job Agent is
# already running there, the launcher opens it instead of starting another.
# DASHBOARD_PORT=4646
# true = do not open a browser tab on start (also: npm run app -- --no-open).
# APP_NO_OPEN=true

# --- Logging & terminal output ---
# Level of the JSON run log in logs/run-<id>.log (trace|debug|info|warn|error).
# LOG_LEVEL=info
# Level of the JSON log echoed to the terminal (default error, so the human
# summary owns the console). Raise to info/debug while debugging.
# LOG_CONSOLE=error
# Any value disables ANSI colors in terminal output (https://no-color.org).
# NO_COLOR=1

# --- Python (resume tailoring) ---
# Interpreter to use when `python`/`python3` on PATH is not the right one —
# e.g. a virtualenv: PYTHON=.venv/bin/python  (Windows: .venv\Scripts\python.exe).
# PYTHON_EXECUTABLE is accepted as an alias.
# PYTHON=
# PYTHON_EXECUTABLE=

# --- Development / CI only ---
# 1 = browser tests FAIL instead of self-skipping when Chromium cannot launch.
# REQUIRE_BROWSER=1
# Workspace root override (config/, data/, logs/, resumes/). The test suite
# sets it to a throwaway copy; you normally never need it.
# JOB_AGENT_ROOT=


# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL: LLM assist for job-description requirement extraction
# ─────────────────────────────────────────────────────────────────────────────
# OFF by default. When enabled, a model READS each job description and proposes
# requirement phrases, which widens what the tailor can recognize beyond the
# fixed keyword vocabulary in config/scoring.json.
#
# What it can and cannot do:
#   - It ONLY reads the posting. Every phrase it returns is verified to appear
#     VERBATIM in that posting before being accepted, so it cannot invent a
#     requirement.
#   - It NEVER writes resume prose. Accepted phrases feed the same deterministic
#     tailor, which only reorders/emphasizes text already in your master resume
#     and reports the rest as honest gaps.
#   - Requirement extraction sends only the public JD + title. The OTHER
#     features below each need their own switch and send more: resume
#     rewrites, refine and grounded letters send resume bullets; reply
#     drafting sends resume bullets and the email it answers; INBOX_LLM sends
#     up to 6,000 characters of an email body. Contact details, EEO answers
#     and salary expectations are never sent by any of them.
#   - It is never consulted on the auto-submit path.
#   - If it is disabled, offline, slow, or returns junk, tailoring silently falls
#     back to the deterministic path.
#
# LLM_ASSIST=on
#
# Pick ONE provider (LLM_PROVIDER). Local providers keep everything on this
# computer; hosted ones receive what each feature sends (see docs/USER_GUIDE.md).
#
#   OpenAI-compatible (the default when LLM_PROVIDER is unset):
#     NVIDIA_API_KEY=nvapi-...        (or LLM_API_KEY for another server)
#     LLM_BASE_URL=https://integrate.api.nvidia.com/v1
#     LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
#     LLM_JSON_MODE=schema            (optional: ask for JSON-schema output)
#   Anthropic (Claude):
#     LLM_PROVIDER=anthropic
#     ANTHROPIC_API_KEY=sk-ant-...
#     LLM_MODEL=claude-opus-5-5       (the default)
#   Ollama, on this computer (no key):
#     LLM_PROVIDER=ollama
#     LLM_MODEL=llama3.2              (any model you have pulled)
#     LLM_BASE_URL=http://localhost:11434
#   LM Studio, on this computer (no key):
#     LLM_PROVIDER=lmstudio
#     LLM_MODEL=<the model loaded in LM Studio>
#     LLM_BASE_URL=http://localhost:1234/v1
#
# LLM_TIMEOUT_MS=30000               (defaults: 30s hosted, 120s Anthropic, 180s local)
# LLM_CACHE=off                       (answers are cached in .tmp/llm-cache by default)
# Token counts per call (never prompts or answers) go to logs/llm-usage.jsonl.


# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL: writing with your resume as the only source (needs LLM_ASSIST=on)
# ─────────────────────────────────────────────────────────────────────────────
# Rewrite suggestions: a model proposes rewordings of your bullets for a job.
# Each one is checked against your own resume (numbers, named tools, employers,
# how much ownership it claims); what it cannot back is not offered. Nothing
# changes until you accept a suggestion in the job's detail.
# RESUME_REWRITE=suggest
#
# Cover letters written paragraph by paragraph from your resume, each checked
# the same way; falls back to your template when fewer than two paragraphs pass.
# COVER_LETTER_MODE=grounded

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL: PDFs, backups, inbox, calendar, ranking
# ─────────────────────────────────────────────────────────────────────────────
# Resume PDFs: auto (Word/LibreOffice when they work, else Chromium, so a PDF
# always exists), chromium (always Chromium) or office (never Chromium).
# RESUME_PDF_ENGINE=auto
#
# Daily backups of every job list are on by default (data/backups). How many
# daily and weekly copies to keep:
# JOB_AGENT_BACKUP_KEEP_DAILY=3
# JOB_AGENT_BACKUP_KEEP_WEEKLY=2
#
# Email replies: read replies about applications you submitted and suggest the
# outcome. Read-only: it never sends, moves or marks mail. Use an app password
# and store it with: npm run secret -- set INBOX_IMAP_PASSWORD
# INBOX=imap
# INBOX_IMAP_HOST=imap.gmail.com
# INBOX_IMAP_USER=you@example.com
# INBOX_LOOKBACK_DAYS=30
# Let the LLM (LLM_ASSIST=on) classify replies the rules cannot. Off by
# default: it sends up to 6,000 characters of each such email to the provider.
# INBOX_LLM=on
#
# Desktop alerts when a follow-up you set is due:
# FOLLOWUP_NOTIFY=on
#
# Rank your top matches by meaning, next to the fit score (which still decides
# tiers). Needs an embeddings model; Anthropic has none, Ollama works locally:
# RERANK=on
# RERANK_PROVIDER=ollama
# RERANK_MODEL=nomic-embed-text
#
# The MCP server (npm run mcp) leaves your name and email out of the profile it
# shares unless you allow it:
# MCP_SHARE_CONTACT=1
#
# Where secrets are kept (keychain, dpapi, secret-tool or file); chosen
# automatically when unset:
# JOB_AGENT_SECRET_BACKEND=
